{
  "expo": {
    "name": "Ledgerly",
    "slug": "ledgerly",
    "scheme": "ledgerly",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f6f7f4",
      "resizeMode": "contain"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.ledgerly"
    },
    "android": {
      "package": "com.example.ledgerly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f6f7f4"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-document-picker"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
